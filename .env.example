# Copie para .env.local no desenvolvimento. No Netlify, cadastre as mesmas
# variáveis em Site configuration > Environment variables.
# Nunca coloque valores reais neste arquivo: ele vai para o repositório.

# --- Banco de dados (obrigatório para pedidos e painel) ---
# Desenvolvimento: arquivo local. Netlify: URL do Turso (libsql://...).
TURSO_DATABASE_URL=file:local.db
# Token do Turso. Não é usado com arquivo local.
TURSO_AUTH_TOKEN=

# --- Painel do ateliê (obrigatório para /admin) ---
ADMIN_PASSWORD=
# Texto aleatório com 32 caracteres ou mais. Gere com: openssl rand -base64 32
SESSION_SECRET=

# --- Endereço público do site ---
# No Netlify pode ficar vazio: o site usa a variável URL que o Netlify preenche.
SITE_URL=http://localhost:3000

# --- Pix direto (opcional; sem a chave, a opção não aparece) ---
PIX_KEY=
# Nome e cidade do recebedor como aparecem no banco (até 25 e 15 caracteres).
# Não são segredos (aparecem em todo QR de Pix): no Netlify, não marque estas
# duas como "Contains secret values", ou o build falha se o mesmo texto
# existir em algum arquivo do site.
PIX_RECEBEDOR=Proxy do Reis
PIX_CIDADE=

# --- Mercado Pago (opcional; sem o token, a opção não aparece) ---
# Use as credenciais de TESTE enquanto estiver desenvolvendo.
MERCADOPAGO_ACCESS_TOKEN=
# Assinatura secreta gerada em Suas integrações > Webhooks.
MERCADOPAGO_WEBHOOK_SECRET=

# --- Aviso de pedido novo pelo Telegram (opcional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
